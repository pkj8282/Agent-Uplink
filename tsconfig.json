{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["shared/**/*.ts", "hub/**/*.ts", "mcp/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "hub/testing.ts"]
}
